{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unfold.dev/schemas/unfold-board-1.schema.json",
  "title": "unfold-board version 1",
  "description": "An Unfold board: titled pages of cards that reference blocks and entrances by structural key (in the board's own project, or in another project named by its shared name), their positions and views, groups of consecutive sibling statements, attributed descriptions and Flow labels, guards that keep references from reattaching to different code, links drawn between items (connections, when they have a kind), frames around items, resource cards, and notes. A changes copy of a published board (`.unfold/local/drafts/<name>.changes.json`) also names the board it publishes and the revision it started from. Unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "pages", "projects", "title", "version"],
  "dependentRequired": {
    "publishes": ["baseRevision"],
    "baseRevision": ["publishes"]
  },
  "properties": {
    "format": { "const": "unfold-board" },
    "version": { "const": 1 },
    "title": { "$ref": "#/$defs/text", "description": "The board's title." },
    "folder": {
      "type": "string",
      "description": "The board folder: 1 to 8 names joined by `/`, each 1 to 64 characters without leading or trailing whitespace, control characters, or `\\`, and not `.` or `..`. Absent at the top level.",
      "pattern": "^(?!\\.\\.?(/|$))[^\\s/\\\\\\p{Cc}](?:[^/\\\\\\p{Cc}]{0,62}[^\\s/\\\\\\p{Cc}])?(?:/(?!\\.\\.?(/|$))[^\\s/\\\\\\p{Cc}](?:[^/\\\\\\p{Cc}]{0,62}[^\\s/\\\\\\p{Cc}])?){0,7}$"
    },
    "projects": {
      "type": "array",
      "description": "The shared names of the other projects the board's items name: exactly the set of the cards' `ref.project`, the resources' `project`, the anchors' `project`, and the links' `carriesProject` values, sorted.",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/projectName" }
    },
    "pages": {
      "type": "array",
      "description": "The pages, in order. Page ids are unique in the board.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "publishes": {
      "type": "string",
      "description": "Only in a changes copy: `boards/<name>.json`, the published board it holds changes for (matching its file name).",
      "pattern": "^boards/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "baseRevision": {
      "type": "string",
      "description": "Only in a changes copy: the SHA-256 of the published file it started from.",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "description": "A page or item id. Card, group, frame, resource, link, and note ids are unique together within their page.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "projectName": {
      "type": "string",
      "description": "A project's shared name (`[project] name` in its `.unfold/config.toml`, or its default).",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "project": {
      "$ref": "#/$defs/projectName",
      "description": "The project the key is in; absent for the board's own project."
    },
    "view": {
      "enum": ["code", "flow", "diagram"]
    },
    "position": {
      "type": "array",
      "description": "A canvas position.",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "signature": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "blockKey": {
      "type": "string",
      "pattern": "^(?!entrance:).*#",
      "description": "A structural block key: the file path, `#`, then the steps."
    },
    "entranceKey": {
      "type": "string",
      "pattern": "^entrance:",
      "description": "A structural entrance key."
    },
    "author": {
      "type": "string",
      "pattern": "^(person|agent):.*\\S",
      "description": "`person:<username>` or `agent:<name>`."
    },
    "textSignature": {
      "description": "`sha256:` and the hash of the exact selected source bytes; empty until a save signs it from verified source.",
      "anyOf": [{ "$ref": "#/$defs/signature" }, { "const": "" }]
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "text"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "author": { "$ref": "#/$defs/author" },
        "signature": { "$ref": "#/$defs/textSignature" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cards", "defaultView", "groups", "id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text", "description": "The page's title." },
        "defaultView": { "$ref": "#/$defs/view", "description": "The view of cards without their own." },
        "cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/card" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "labels": {
          "type": "array",
          "description": "Flow-node labels, one per (project, key), sorted by project (the board's own first) and key.",
          "items": { "$ref": "#/$defs/label" }
        },
        "guards": {
          "type": "array",
          "description": "What each reference was when it was saved, one per (project, key), sorted like labels.",
          "items": { "$ref": "#/$defs/guard" }
        },
        "links": {
          "type": "array",
          "description": "Links drawn between two cards, resources, or frames of the page; a link with a `kind` is a connection.",
          "items": { "$ref": "#/$defs/link" }
        },
        "frames": {
          "type": "array",
          "description": "Named boxes around items of the page, sorted by id. Written only when there are some.",
          "items": { "$ref": "#/$defs/frame" }
        },
        "resources": {
          "type": "array",
          "description": "Resource cards, sorted by id. Written only when there are some.",
          "items": { "$ref": "#/$defs/resource" }
        },
        "notes": {
          "type": "array",
          "description": "Notes, sorted by id. Written only when there are some.",
          "items": { "$ref": "#/$defs/note" }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "id", "ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ref": {
          "description": "Exactly one block or entrance, and its project when it is not the board's own.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["block"],
              "properties": {
                "block": { "$ref": "#/$defs/blockKey" },
                "project": { "$ref": "#/$defs/project" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["entrance"],
              "properties": {
                "entrance": { "$ref": "#/$defs/entranceKey" },
                "project": { "$ref": "#/$defs/project" }
              }
            }
          ]
        },
        "at": { "$ref": "#/$defs/position" },
        "view": { "$ref": "#/$defs/view" },
        "folded": { "type": "boolean", "description": "Written only when true." },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card", "collapsed", "id", "members", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "card": { "$ref": "#/$defs/id", "description": "The id of the block card of this page the group belongs to." },
        "title": { "$ref": "#/$defs/text" },
        "members": {
          "type": "array",
          "description": "The keys (in the card's project) of consecutive sibling statements with one parent and one body role.",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/blockKey" }
        },
        "collapsed": { "type": "boolean" },
        "description": { "$ref": "#/$defs/description" },
        "author": { "$ref": "#/$defs/author", "description": "Who wrote the title; absent on groups titled before titles were attributed." }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "key", "text"],
      "properties": {
        "key": { "$ref": "#/$defs/blockKey" },
        "project": { "$ref": "#/$defs/project" },
        "text": { "$ref": "#/$defs/text" },
        "author": { "$ref": "#/$defs/author" },
        "signature": { "$ref": "#/$defs/textSignature" }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "owner", "signature"],
      "properties": {
        "key": { "$ref": "#/$defs/text", "description": "A block or entrance key." },
        "project": { "$ref": "#/$defs/project" },
        "kind": {
          "type": "string",
          "description": "The block kind, or `entrance:` and the entrance kind.",
          "pattern": "^(file|function|class|method|constructor|getter|setter|variable|call|new|import|if|for|for_in|for_of|while|do_while|switch|case|default|try|catch|return|throw|break|continue|expression_statement|with|match|interface|type_alias|enum|entrance:(process|command|http|worker|schedule|event))$"
        },
        "owner": { "type": "string", "description": "The owner's block key; empty for an entrance." },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "anchor": {
      "description": "What a resource card or a connection cites: a block or entrance key, or lines of an evidence file, with the project when it is not the board's own.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": {
            "key": {
              "type": "string",
              "description": "A block key or an entrance key.",
              "pattern": "^entrance:|^[^#]+#"
            },
            "project": { "$ref": "#/$defs/project" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "lines"],
          "properties": {
            "file": {
              "type": "string",
              "description": "An evidence file, relative to its project's folder, `/`-separated, without `.` or `..` parts.",
              "pattern": "^(?![A-Za-z]:)(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+(?:/(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+)*$"
            },
            "lines": {
              "type": "array",
              "description": "The first and last line, 1-based and inclusive.",
              "prefixItems": [
                { "type": "integer", "minimum": 1 },
                { "type": "integer", "minimum": 1 }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "project": { "$ref": "#/$defs/project" }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "id", "to"],
      "dependentRequired": {
        "kind": ["author"],
        "carriesProject": ["carries"]
      },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id", "description": "The card, resource, or frame it starts at: the side that acts." },
        "to": { "$ref": "#/$defs/id", "description": "The card, resource, or frame it points at; another item than `from`." },
        "label": {
          "$ref": "#/$defs/description",
          "description": "Its label, signed over the guard signatures of both ends."
        },
        "kind": {
          "enum": ["http", "rpc", "queue", "event", "writes", "reads", "calls", "relates", "other"],
          "description": "How its ends talk; absent for a drawn link (`other`)."
        },
        "step": { "$ref": "#/$defs/blockKey", "description": "The statement or call inside the `from` card's block it leaves from (a block card's)." },
        "fromColumn": { "$ref": "#/$defs/text", "description": "For `relates`: the column of the `from` table." },
        "toColumn": { "$ref": "#/$defs/text", "description": "For `relates`: the column of the `to` table." },
        "channel": { "$ref": "#/$defs/text", "description": "What travels: the route, the queue, or the event." },
        "carries": { "$ref": "#/$defs/blockKey", "description": "The type it carries: a type declaration or class key." },
        "carriesProject": { "$ref": "#/$defs/project", "description": "The project of `carries`; absent for the board's own." },
        "cardinality": {
          "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"],
          "description": "For `relates`: how many rows of each table it joins."
        },
        "anchors": {
          "type": "array",
          "description": "The evidence for the receiving side. Written only when there are some.",
          "items": { "$ref": "#/$defs/anchor" }
        },
        "description": { "$ref": "#/$defs/description" },
        "author": { "$ref": "#/$defs/author", "description": "Who drew it; required with `kind`." },
        "signature": { "$ref": "#/$defs/textSignature" }
      },
      "if": {
        "not": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "relates" } } }
      },
      "then": {
        "type": "object",
        "properties": { "fromColumn": false, "toColumn": false, "cardinality": false }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "id", "look", "members", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/description" },
        "members": {
          "type": "array",
          "description": "The ids of the cards, resources, notes, and frames of the page it holds. An item is in at most one frame; frames nest at most 3 deep, without cycles.",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "look": { "enum": ["box", "zone"] },
        "icon": { "enum": ["api", "worker", "schedule", "cli", "web", "library", "system"] },
        "direction": { "enum": ["right", "down"] },
        "collapsed": { "type": "boolean", "description": "Written only when true." },
        "author": { "$ref": "#/$defs/author" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "dependentSchemas": {
        "references": { "type": "object", "required": ["key"], "properties": { "key": { "const": "foreign" } } }
      },
      "properties": {
        "name": { "$ref": "#/$defs/text", "description": "Unique in its table." },
        "type": { "$ref": "#/$defs/text", "description": "The type as written." },
        "key": { "enum": ["primary", "foreign", "unique"] },
        "references": { "$ref": "#/$defs/text", "description": "What a foreign key references." },
        "optional": { "type": "boolean", "description": "Written only when true." }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors", "at", "author", "id", "kind", "name"],
      "dependentRequired": {
        "project": ["type"]
      },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["table", "queue", "cache", "storage", "external", "actor"] },
        "name": { "$ref": "#/$defs/text", "description": "The technical name, such as `orders`." },
        "project": { "$ref": "#/$defs/project", "description": "The project of `type`; absent for the board's own." },
        "type": { "$ref": "#/$defs/blockKey", "description": "For a table: the type declaration or class that declares its shape." },
        "columns": {
          "type": "array",
          "description": "For a table: its columns (names unique), or, for a table backed by a type, marks only. Written only when there are some.",
          "items": { "$ref": "#/$defs/column" }
        },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/anchor" }
        },
        "at": { "$ref": "#/$defs/position" },
        "description": { "$ref": "#/$defs/description" },
        "author": { "$ref": "#/$defs/author" },
        "signature": { "$ref": "#/$defs/textSignature" }
      },
      "allOf": [
        {
          "if": { "not": { "type": "object", "properties": { "kind": { "const": "table" } } } },
          "then": { "type": "object", "properties": { "type": false, "columns": false } }
        },
        {
          "if": { "type": "object", "required": ["type"] },
          "then": {
            "type": "object",
            "properties": {
              "columns": { "type": "array", "items": { "type": "object", "properties": { "type": false, "optional": false } } }
            }
          }
        }
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "author", "id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "pattern": "\\S", "maxLength": 400, "description": "Plain text, at most 400 characters." },
        "at": { "$ref": "#/$defs/position", "description": "The canvas position; an offset from the attached item's top-left (a link's midpoint) when attached." },
        "attach": { "$ref": "#/$defs/id", "description": "The card, frame, resource, or link it is attached to." },
        "author": { "$ref": "#/$defs/author" }
      }
    }
  }
}
