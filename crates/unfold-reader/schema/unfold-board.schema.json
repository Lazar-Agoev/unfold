{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unfold.dev/schemas/unfold-board-1.schema.json",
  "title": "unfold-board version 1",
  "description": "An Unfold board: titled pages of cards that show blocks, apps, and entrances of the board's project by key, with their positions, views, descriptions, and the calls they open in place; the page's overlay of names, combined steps, and proposed steps, which apply page-wide by key; guards that keep references from reattaching to different code; connections between items; frames around items; resource cards; and notes. Unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "pages", "title", "version"],
  "properties": {
    "format": { "const": "unfold-board" },
    "version": { "const": 1 },
    "title": { "$ref": "#/$defs/text", "description": "The board's title." },
    "folder": {
      "type": "string",
      "description": "The board folder: one name of 1 to 64 characters without `/`, `\\`, control characters, or leading or trailing whitespace, and not `.` or `..`. Folders are one level deep. Absent at the top level.",
      "pattern": "^(?!\\.\\.?$)[^\\s/\\\\\\p{Cc}](?:[^/\\\\\\p{Cc}]{0,62}[^\\s/\\\\\\p{Cc}])?$"
    },
    "pages": {
      "type": "array",
      "description": "The pages, in order. Page ids are unique in the board.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "id": {
      "type": "string",
      "description": "A page or item id. Card, combined step, frame, resource, connection, note, and proposal ids are unique together within their page.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "view": { "enum": ["compact", "expanded"] },
    "position": {
      "type": "array",
      "description": "A canvas position.",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "signature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "blockKey": {
      "type": "string",
      "pattern": "^(?!entrance:).*#",
      "description": "A block key: the file path, `#`, then the names and steps."
    },
    "entranceKey": {
      "type": "string",
      "pattern": "^entrance:[^/#\\s]+(?:/[^/#\\s]+)?$",
      "description": "An app's key (`entrance:<app>`) or an entrance's (`entrance:<app>/<entrance>`)."
    },
    "author": {
      "type": "string",
      "pattern": "^(person|agent):.*\\S",
      "description": "`person:<username>` or `agent:<name>`."
    },
    "textSignature": {
      "description": "`sha256:` and the hash of the source it was written for; empty until a save signs it from verified source.",
      "anyOf": [{ "$ref": "#/$defs/signature" }, { "const": "" }]
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "text"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "author": { "$ref": "#/$defs/author" },
        "signature": { "$ref": "#/$defs/textSignature" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cards", "defaultView", "id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text", "description": "The page's title." },
        "defaultView": { "$ref": "#/$defs/view", "description": "The view of cards without their own." },
        "cards": { "type": "array", "items": { "$ref": "#/$defs/card" } },
        "names": {
          "type": "array",
          "description": "Names of blocks, one per key, sorted by key. A name applies wherever the page draws its block.",
          "items": { "$ref": "#/$defs/name" }
        },
        "combined": {
          "type": "array",
          "description": "Combined steps, sorted by id. They apply wherever the page draws their blocks, and never overlap or nest.",
          "items": { "$ref": "#/$defs/combined" }
        },
        "guards": {
          "type": "array",
          "description": "What each reference was when it was saved, one per key, sorted by key.",
          "items": { "$ref": "#/$defs/guard" }
        },
        "links": {
          "type": "array",
          "description": "Connections between two cards, resources, or frames of the page, sorted by id.",
          "items": { "$ref": "#/$defs/connection" }
        },
        "frames": {
          "type": "array",
          "description": "Named boxes around items of the page, sorted by id. Written only when there are some.",
          "items": { "$ref": "#/$defs/frame" }
        },
        "resources": {
          "type": "array",
          "description": "Resource cards, sorted by id. Written only when there are some.",
          "items": { "$ref": "#/$defs/resource" }
        },
        "notes": {
          "type": "array",
          "description": "Notes, sorted by id. Written only when there are some.",
          "items": { "$ref": "#/$defs/note" }
        },
        "proposals": {
          "type": "array",
          "description": "Proposed steps, sorted by id: at most 200. They apply wherever the page draws their place. Written only when there are some.",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/proposal" }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "id", "ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ref": {
          "description": "A block (a module, definition, or type), or an app's start or an entrance.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["block"],
              "properties": { "block": { "$ref": "#/$defs/blockKey" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["entrance"],
              "properties": { "entrance": { "$ref": "#/$defs/entranceKey" } }
            }
          ]
        },
        "at": { "$ref": "#/$defs/position" },
        "view": { "$ref": "#/$defs/view", "description": "The card's own view; the page's default when absent." },
        "description": {
          "$ref": "#/$defs/description",
          "description": "Signed over the card's code: a block's source, or the source of an app's or entrance's code."
        },
        "open": {
          "type": "array",
          "description": "The calls a block card opens in place, at most 64: each a path of 1 to 3 keys of project calls or callbacks, outermost first, each drawn in what the one before it opens. Never guarded. Written only when there are some.",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/blockKey" } }
        }
      },
      "if": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": {
            "type": "object",
            "required": ["entrance"],
            "properties": { "entrance": { "$ref": "#/$defs/entranceKey" } }
          }
        }
      },
      "then": { "type": "object", "properties": { "open": { "type": "array", "maxItems": 0 } } }
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "key", "text"],
      "properties": {
        "key": { "$ref": "#/$defs/blockKey" },
        "text": { "$ref": "#/$defs/text" },
        "author": { "$ref": "#/$defs/author" },
        "signature": { "$ref": "#/$defs/textSignature", "description": "Signed over the block's source." }
      }
    },
    "combined": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "collapsed", "id", "members", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "members": {
          "type": "array",
          "description": "Block keys: consecutive blocks of one body, in written order, or one whole control block. A key is in at most one combined step.",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/blockKey" }
        },
        "collapsed": { "type": "boolean" },
        "description": { "$ref": "#/$defs/description" },
        "author": { "$ref": "#/$defs/author", "description": "Who combined the blocks." },
        "signature": {
          "$ref": "#/$defs/textSignature",
          "description": "Signed over the source from the first block's start to the last block's end."
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "owner", "signature"],
      "properties": {
        "key": { "type": "string", "description": "A block, app, or entrance key.", "pattern": "^entrance:|#" },
        "kind": {
          "enum": [
            "module",
            "class",
            "function",
            "type",
            "decision",
            "loop",
            "try",
            "with",
            "part",
            "call",
            "exit",
            "entrance"
          ],
          "description": "The block's node kind, or `entrance` for an app or entrance."
        },
        "owner": {
          "type": "string",
          "description": "The owner's block key; empty for a module, an app, or an entrance."
        },
        "signature": {
          "$ref": "#/$defs/signature",
          "description": "A block's source signature; for an app or entrance, the signature of its `code` keys, each followed by a newline."
        }
      }
    },
    "anchor": {
      "description": "What a resource card or a connection cites: a block, app, or entrance key, or lines of an evidence file.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": {
            "key": {
              "type": "string",
              "description": "A block key, or an app's or entrance's key.",
              "pattern": "^entrance:|^[^#]+#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "lines"],
          "properties": {
            "file": {
              "type": "string",
              "description": "An evidence file, relative to the project's folder, `/`-separated, without `.` or `..` parts.",
              "pattern": "^(?![A-Za-z]:)(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+(?:/(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+)*$"
            },
            "lines": {
              "type": "array",
              "description": "The first and last line, 1-based and inclusive.",
              "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "from", "id", "kind", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": {
          "$ref": "#/$defs/id",
          "description": "The card, resource, or frame it starts at: the side that acts."
        },
        "to": {
          "$ref": "#/$defs/id",
          "description": "The card, resource, or frame it points at; another item than `from`."
        },
        "kind": {
          "enum": ["http", "queue", "reads", "writes", "calls", "relates", "other"],
          "description": "What the line stands for."
        },
        "label": {
          "$ref": "#/$defs/description",
          "description": "Its label, signed over what it cites; required for `other`."
        },
        "step": {
          "$ref": "#/$defs/blockKey",
          "description": "The key of the call inside the `from` card's block it leaves from (a block card's). A `calls` connection starts at an unknown call."
        },
        "fromColumn": { "$ref": "#/$defs/text", "description": "For `relates`: the column of the `from` table." },
        "toColumn": { "$ref": "#/$defs/text", "description": "For `relates`: the column of the `to` table." },
        "channel": { "$ref": "#/$defs/text", "description": "What travels: the route, the queue, or the event." },
        "carries": {
          "$ref": "#/$defs/blockKey",
          "description": "The type it carries: a type declaration or class key."
        },
        "cardinality": {
          "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"],
          "description": "For `relates`: how many rows of each table it joins."
        },
        "anchors": {
          "type": "array",
          "description": "What it cites besides its step. Written only when there are some.",
          "items": { "$ref": "#/$defs/anchor" }
        },
        "description": { "$ref": "#/$defs/description" },
        "author": { "$ref": "#/$defs/author", "description": "Who drew it." },
        "signature": {
          "$ref": "#/$defs/signature",
          "description": "Signed over its step's and anchors' source; absent until a save signs it, and when it cites nothing."
        }
      },
      "allOf": [
        {
          "if": {
            "not": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "relates" } } }
          },
          "then": {
            "type": "object",
            "properties": { "fromColumn": false, "toColumn": false, "cardinality": false }
          }
        },
        {
          "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "other" } } },
          "then": { "type": "object", "required": ["label"], "properties": { "label": true } }
        }
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "id", "look", "members", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/description" },
        "members": {
          "type": "array",
          "description": "The ids of the cards, resources, notes, and frames of the page it holds. An item is in at most one frame; frames nest at most 3 deep, without cycles.",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "look": { "enum": ["box", "zone"] },
        "icon": { "enum": ["api", "worker", "schedule", "cli", "web", "library", "system"] },
        "direction": { "enum": ["right", "down"] },
        "collapsed": { "type": "boolean", "description": "Written only when true." },
        "author": { "$ref": "#/$defs/author" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "dependentSchemas": {
        "references": { "type": "object", "required": ["key"], "properties": { "key": { "const": "foreign" } } }
      },
      "properties": {
        "name": { "$ref": "#/$defs/text", "description": "Unique in its table." },
        "type": { "$ref": "#/$defs/text", "description": "The type as written." },
        "key": { "enum": ["primary", "foreign", "unique"] },
        "references": { "$ref": "#/$defs/text", "description": "What a foreign key references." },
        "optional": { "type": "boolean", "description": "Written only when true." }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors", "at", "author", "id", "kind", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["table", "queue", "cache", "storage", "external", "actor"] },
        "name": { "$ref": "#/$defs/text", "description": "The technical name, such as `orders`." },
        "type": {
          "$ref": "#/$defs/blockKey",
          "description": "For a table: the type declaration or class that declares its shape."
        },
        "columns": {
          "type": "array",
          "description": "For a table: its columns (names unique), or, for a table backed by a type, marks only. Written only when there are some.",
          "items": { "$ref": "#/$defs/column" }
        },
        "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
        "at": { "$ref": "#/$defs/position" },
        "description": { "$ref": "#/$defs/description" },
        "author": { "$ref": "#/$defs/author" },
        "signature": { "$ref": "#/$defs/textSignature" }
      },
      "allOf": [
        {
          "if": {
            "not": { "type": "object", "properties": { "kind": { "const": "table" } } }
          },
          "then": { "type": "object", "properties": { "type": false, "columns": false } }
        },
        {
          "if": { "type": "object", "required": ["type"] },
          "then": {
            "type": "object",
            "properties": {
              "columns": {
                "type": "array",
                "items": { "type": "object", "properties": { "type": false, "optional": false } }
              }
            }
          }
        }
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "author", "id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 400,
          "description": "Plain text, at most 400 characters."
        },
        "at": {
          "$ref": "#/$defs/position",
          "description": "The canvas position; an offset from the attached item's top-left (a connection's midpoint) when attached."
        },
        "attach": {
          "$ref": "#/$defs/id",
          "description": "The card, frame, resource, or connection it is attached to."
        },
        "author": { "$ref": "#/$defs/author" }
      }
    },
    "proposal": {
      "type": "object",
      "description": "A proposed step: an intended change, not a compiler fact. It goes after a block or at the start of a body, has no source, and is never signed; its place is guarded.",
      "additionalProperties": false,
      "required": ["author", "id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "after": { "$ref": "#/$defs/blockKey", "description": "The block it goes after: a step of a body." },
        "start": {
          "$ref": "#/$defs/blockKey",
          "description": "The definition or part at the start of whose body it goes."
        },
        "title": {
          "type": "string",
          "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$",
          "maxLength": 120,
          "description": "What it would do: one line of at most 120 characters, without control characters."
        },
        "reason": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 400,
          "description": "Why: at most 400 characters."
        },
        "author": { "$ref": "#/$defs/author", "description": "Who proposed it." }
      },
      "oneOf": [
        { "type": "object", "required": ["after"], "properties": { "after": true } },
        { "type": "object", "required": ["start"], "properties": { "start": true } }
      ]
    }
  }
}
