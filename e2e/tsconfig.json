{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Callbacks passed to page.evaluate run in the window, so they see the DOM.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "journeys/**/*.ts", "budgets/**/*.ts", "playwright.config.ts"]
}
