{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "e2e",
    "tools/oracles",
    "crates/unfold-node"
  ],
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "ui": {
      "project": [
        "src/**/*.{ts,tsx}!"
      ],
      "ignore": [
        "src/ipc/generated/**"
      ]
    },
    "desktop": {
      "project": [
        "src/**/*.ts!"
      ]
    }
  }
}
