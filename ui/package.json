{
  "name": "@unfold/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Unfold's React UI. It talks to the rest of the app only through window.unfold.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
