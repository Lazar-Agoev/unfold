# One image for the query service (web) and the nightly export (cron).
# Render's build context is the repo root; see render.yaml.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DASHBOARD_BUILDER_ENV=production

WORKDIR /app

COPY data-pipelines/requirements-dashboard-builder.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY data-pipelines/dashboard_builder ./dashboard_builder

# Web service: uvicorn on $PORT. The cron overrides this with the export command.
CMD ["sh", "-c", "uvicorn dashboard_builder.app:app --host 0.0.0.0 --port ${PORT:-8010}"]
