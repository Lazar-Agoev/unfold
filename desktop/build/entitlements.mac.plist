<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Unfold and its helper processes (renderers and the engine host).
  The minimal set: V8 needs to JIT, and nothing else is granted. No library-validation exception is
  needed because the engine addon is signed with the app's own certificate; no camera, microphone,
  network-server, or Apple Events entitlements because Unfold uses none of them.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
