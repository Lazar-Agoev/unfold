{
  "name": "@unfold/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Unfold's Electron shell: the main process, the preload script, and the engine host.",
  "productName": "Unfold",
  "author": "The Unfold authors",
  "main": "out/main/index.js",
  "exports": {
    "./unfold-api": {
      "types": "./src/shared/unfold-api.ts"
    },
    "./agent-api": {
      "types": "./src/shared/agent-api.ts"
    },
    "./render-api": {
      "types": "./src/shared/render-api.ts"
    },
    "./drawing": {
      "types": "./src/shared/drawing.ts",
      "default": "./src/shared/drawing.ts"
    },
    "./revision": {
      "types": "./src/shared/revision.ts",
      "default": "./src/shared/revision.ts"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "bundle:dir": "electron-builder --config electron-builder.yml --dir --publish never",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/preload/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "24.19.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
