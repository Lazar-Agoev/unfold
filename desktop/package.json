{
  "name": "@unfold/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Unfold's Electron shell: the main process, the preload script, and the engine host.",
  "productName": "Unfold",
  "author": "The Unfold authors",
  "main": "out/main/index.js",
  "exports": {
    "./unfold-api": {
      "types": "./src/shared/unfold-api.ts"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "bundle": "electron-builder --config electron-builder.yml --publish never",
    "bundle:dir": "electron-builder --config electron-builder.yml --dir --publish never",
    "smoke": "node scripts/smoke.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/preload/tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright-core": "1.64.0",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
